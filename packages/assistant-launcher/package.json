{
  "name": "dsh-assistant-launcher",
  "version": "0.1.1",
  "description": "One-click continuable subagent launcher for DeepSeek Harness: a composer menu with 11 persona'd assistants (ops, research, audit, ...) that spawn independent-context subagents you can talk to directly.",
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "subagent",
    "assistant",
    "launcher"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": "^0.1.0-rc.6"
  },
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-slots"
      ],
      "platform": "web"
    }
  }
}
