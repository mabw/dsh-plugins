{
  "name": "dsh-tasknav",
  "version": "0.1.1",
  "description": "Task-tree navigation and decision memory for DeepSeek Harness operational workflows: task_tree tool, collapsible dock UI with status/decision badges, click-to-focus topic locking, per-step decision-chain injection (compaction-proof), CLI records, and .tasknav/ file persistence.",
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "task-tree",
    "workflow",
    "decision-log"
  ],
  "license": "MIT",
  "type": "module",
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": "^0.1.0-rc.6"
  },
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/cordis-plugin-timer",
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-slots"
      ],
      "platform": "web"
    }
  }
}
